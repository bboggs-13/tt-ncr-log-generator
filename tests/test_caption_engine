import unittest
from unittest.mock import patch

import fitz

import caption_engine
from caption_engine import (
    CaptionJob, _existing_caption_without_prefix, analyze_pdf, apply_captions, format_caption, parse_observation,
)


def make_sample_pdf():
    doc = fitz.open()
    detail = doc.new_page(width=595, height=842)
    detail.insert_text((30, 100), "Special Inspection Report #42")
    detail.insert_text((30, 140), "E. Non-Conformance Observation 42.NC.3")
    photos = doc.new_page(width=595, height=842)
    photos.insert_text((30, 90), "Photographs:")
    pix = fitz.Pixmap(fitz.csRGB, fitz.IRect(0, 0, 640, 480), 0)
    pix.clear_with(0xD0D0D0)
    photos.insert_image(fitz.Rect(40, 120, 300, 315), pixmap=pix)
    photos.insert_text((40, 328), "Existing condition caption", fontsize=10.5)
    return doc.tobytes()


class CaptionEngineTests(unittest.TestCase):
    def test_format_caption_uses_requested_prefix(self):
        self.assertEqual(
            format_caption("65", "NCR", "2", 3, "Thermal shim missing"),
            "65.NCR.2-3: Thermal shim missing",
        )
        self.assertEqual(
            format_caption("65", "GO", "1", 1, "Work in progress"),
            "65.GO.1-1: Work in progress",
        )

    def test_existing_caption_removes_new_or_legacy_generated_prefix(self):
        self.assertEqual(
            _existing_caption_without_prefix("65.NCR.2-3: Thermal shim missing"),
            "Thermal shim missing",
        )
        self.assertEqual(
            _existing_caption_without_prefix("65.NCR.2-PHOTO 3: Thermal shim missing"),
            "Thermal shim missing",
        )

    def test_parse_observation_detail_headings(self):
        self.assertEqual(parse_observation("E. Non-Conformance Observation 65.NC.1"), ("NCR", "1"))
        self.assertEqual(parse_observation("F. General Observation # 1"), ("GO", "1"))
        self.assertIsNone(parse_observation("Non-conformance Observations:"))

    def test_all_generated_captions_use_the_smallest_required_font_size(self):
        source_doc = fitz.open()
        source_doc.new_page(width=595, height=842)
        source = source_doc.tobytes()
        source_doc.close()
        jobs = [
            CaptionJob(0, 1, "NCR", "1", "Short caption", (40, 100, 250, 200), (40, 205, 280, 235)),
            CaptionJob(0, 2, "NCR", "1", "Longer caption needing a smaller size", (300, 100, 500, 200), (300, 205, 560, 235)),
        ]

        with patch("caption_engine._fit_font_size", side_effect=[10.5, 8.0]):
            output, warnings = apply_captions(source, jobs, "65")

        result = fitz.open(stream=output, filetype="pdf")
        sizes = {
            round(span["size"], 2)
            for block in result[0].get_text("dict")["blocks"]
            for line in block.get("lines", [])
            for span in line.get("spans", [])
        }
        result.close()
        self.assertEqual(sizes, {8.0})
        self.assertTrue(any("for all 2 generated photo captions" in warning for warning in warnings))

    def test_unfit_caption_prevents_partial_mixed_size_replacements(self):
        source_doc = fitz.open()
        source_doc.new_page(width=595, height=842)
        source = source_doc.tobytes()
        source_doc.close()
        jobs = [
            CaptionJob(0, 1, "NCR", "1", "Short caption", (40, 100, 250, 200), (40, 205, 280, 235)),
            CaptionJob(0, 2, "NCR", "1", "Caption too large", (300, 100, 500, 200), (300, 205, 560, 235)),
        ]

        with patch("caption_engine._fit_font_size", side_effect=[10.5, None]):
            output, warnings = apply_captions(source, jobs, "65")

        result = fitz.open(stream=output, filetype="pdf")
        text = result[0].get_text()
        result.close()
        self.assertNotIn("65.NCR.1-1", text)
        self.assertNotIn("65.NCR.1-2", text)
        self.assertTrue(any("no generated captions were applied" in warning for warning in warnings))

    def test_detect_and_apply_caption_only_to_photo_page(self):
        source = make_sample_pdf()
        report_no, jobs, notes = analyze_pdf(source)
        self.assertEqual(report_no, "42")
        self.assertEqual(len(jobs), 1)
        self.assertEqual(jobs[0].observation_type, "NCR")
        self.assertEqual(jobs[0].observation_number, "3")
        self.assertEqual(jobs[0].caption, "Existing condition caption")

        output, warnings = apply_captions(source, jobs, report_no)
        self.assertFalse(warnings)
        result = fitz.open(stream=output, filetype="pdf")
        self.assertEqual(len(result), 2)
        self.assertIn("42.NCR.3-1: Existing condition caption", result[1].get_text())
        self.assertNotIn("42.NCR.3-1", result[0].get_text())
        self.assertEqual(len(result[1].get_images(full=True)), 1)
        result.close()



def make_arial_report(identity_encoded: bool):
    """Report whose text uses an Arial-width font labelled ArialMT, like TT reports."""
    doc = fitz.open()
    for _ in range(2):
        doc.new_page(width=595, height=842)
    font_file = str(caption_engine._ARIAL_METRIC_FILE)
    for page in doc:
        page.insert_font(fontname="F1", fontfile=font_file, set_simple=not identity_encoded)
    doc[0].insert_text((30, 100), "Special Inspection Report #42", fontname="F1")
    doc[0].insert_text((30, 140), "E. Non-Conformance Observation 42.NC.3", fontname="F1")
    doc[1].insert_text((30, 90), "Photographs:", fontname="F1")
    pix = fitz.Pixmap(fitz.csRGB, fitz.IRect(0, 0, 640, 480), 0)
    pix.clear_with(0xD0D0D0)
    doc[1].insert_image(fitz.Rect(40, 120, 300, 315), pixmap=pix)
    doc[1].insert_text((40, 328), "Existing condition caption", fontsize=10.5, fontname="F1")
    if identity_encoded:
        doc.subset_fonts()  # PDF tools embed Arial as a subset, which drops the letter map
    for xref in {f[0] for page in doc for f in page.get_fonts(full=True)}:
        doc.xref_set_key(xref, "BaseFont", "/ABCDEF+ArialMT")
    return doc.tobytes()


class CaptionFontTests(unittest.TestCase):
    def setUp(self):
        # Pretend no Arial is installed and none was added to the repo.
        self._files = caption_engine._ARIAL_FILES
        caption_engine._ARIAL_FILES = ()

    def tearDown(self):
        caption_engine._ARIAL_FILES = self._files

    def _font_for(self, source):
        report_no, jobs, _ = analyze_pdf(source)
        return caption_engine.caption_font_for(source, jobs, report_no)

    def test_falls_back_to_arial_width_liberation_sans(self):
        font = self._font_for(make_sample_pdf())
        self.assertFalse(font.is_arial)
        self.assertIn("Liberation Sans", font.label)

    def test_uses_arial_embedded_in_the_report(self):
        font = self._font_for(make_arial_report(identity_encoded=False))
        self.assertTrue(font.is_arial)
        self.assertEqual(font.label, "Arial (embedded in the report)")

    def test_rejects_embedded_font_that_cannot_be_mapped_back_to_letters(self):
        font = self._font_for(make_arial_report(identity_encoded=True))
        self.assertFalse(font.is_arial)

    def test_captions_are_written_in_the_chosen_font_without_clipping_the_photo(self):
        source = make_sample_pdf()
        report_no, jobs, _ = analyze_pdf(source)
        output, _ = apply_captions(source, jobs, report_no)
        page = fitz.open(stream=output, filetype="pdf")[1]
        fonts = {
            span["font"]
            for block in page.get_text("dict")["blocks"]
            for line in block.get("lines", [])
            for span in line["spans"]
            if span["text"].strip()
            and span["bbox"][1] > 300 and span["bbox"][3] < 345
        }
        self.assertEqual(fonts, {"LiberationSans", "LiberationSans-Bold"})
        photo_edge = page.get_pixmap(clip=fitz.Rect(100, 313, 101, 315), matrix=fitz.Matrix(4, 4))
        self.assertLess(photo_edge.pixel(1, 1)[0], 235)  # still photo-gray, not painted white


class PageNumberTests(unittest.TestCase):
    def _report(self, size=10.0):
        doc = fitz.open(stream=make_sample_pdf(), filetype="pdf")
        total = doc.page_count
        for i, page in enumerate(doc):
            text = f"Page {i + 1} of {total}"
            x = 567.3 - fitz.get_text_length(text, fontname="helv", fontsize=size)
            page.insert_text((28.5, 819.0), "IMMEDIATELY BY EMAIL OR TELEPHONE.", fontsize=6)
            page.insert_text((x, 831.3), text, fontname="helv", fontsize=size)
        return doc.tobytes()

    def _page_numbers(self, pdf):
        out = []
        for page in fitz.open(stream=pdf, filetype="pdf"):
            for span in page.get_texttrace():
                text = "".join(chr(c[0]) for c in span["chars"])
                if text.startswith("Page "):
                    out.append((text, span["size"], round(span["bbox"][2], 1)))
        return out

    def test_page_numbers_are_set_to_8_pt_and_stay_right_aligned(self):
        source = self._report()
        report_no, jobs, _ = analyze_pdf(source)
        output, _ = apply_captions(source, jobs, report_no)
        numbers = self._page_numbers(output)
        self.assertEqual([n[0] for n in numbers], ["Page 1 of 2", "Page 2 of 2"])  # old text removed, not doubled
        self.assertEqual({n[1] for n in numbers}, {8.0})
        self.assertEqual({n[2] for n in numbers}, {567.3})
        self.assertIn("IMMEDIATELY BY EMAIL OR TELEPHONE.", fitz.open(stream=output, filetype="pdf")[0].get_text())

    def test_page_numbers_can_be_left_unchanged(self):
        source = self._report()
        report_no, jobs, _ = analyze_pdf(source)
        output, _ = apply_captions(source, jobs, report_no, page_number_size=None)
        self.assertEqual({n[1] for n in self._page_numbers(output)}, {10.0})


class CaptionStyleTests(unittest.TestCase):
    def test_prefix_is_bold_and_description_is_regular(self):
        source = make_sample_pdf()
        report_no, jobs, _ = analyze_pdf(source)
        output, _ = apply_captions(source, jobs, report_no)
        page = fitz.open(stream=output, filetype="pdf")[1]
        spans = [
            span for block in page.get_text("dict")["blocks"] for line in block.get("lines", [])
            for span in line["spans"] if span["text"].strip()
        ]
        prefix = next(sp for sp in spans if sp["text"].startswith("42.NCR.3-1"))
        self.assertEqual(prefix["text"].strip(), "42.NCR.3-1:")
        self.assertTrue(prefix["flags"] & 16 or "Bold" in prefix["font"])
        description = next(sp for sp in spans if sp["origin"][1] == prefix["origin"][1] and sp is not prefix)
        self.assertNotIn("Bold", description["font"])

    def test_long_caption_wraps_inside_its_area(self):
        from caption_engine import _layout_caption
        runs = _layout_caption("65.GO.1-1: " + "Architectural cast-in-place concrete progress " * 3,
                               fitz.Rect(0, 0, 250, 40), 10, None)
        self.assertIsNotNone(runs)
        self.assertGreater(len({baseline for _, baseline, _, _ in runs}), 1)
        self.assertTrue(runs[0][3])   # first run is the bold prefix


class PageNumberDetectionTests(unittest.TestCase):
    def test_page_number_split_into_separate_text_pieces_is_resized(self):
        doc = fitz.open()
        page = doc.new_page(width=595, height=842)
        x = 510.6
        for piece in ("Page ", "3", " of ", "10"):   # separate text objects, as some exporters write
            page.insert_text((x, 831.3), piece, fontname="helv", fontsize=10)
            x += fitz.get_text_length(piece, fontname="helv", fontsize=10)
        stats = {}
        output, warnings = apply_captions(doc.tobytes(), [], "65", stats=stats)
        self.assertEqual((stats["page_numbers_found"], stats["page_numbers_resized"]), (1, 1))
        sizes = {
            span["size"] for span in fitz.open(stream=output, filetype="pdf")[0].get_texttrace()
        }
        self.assertEqual(sizes, {8.0})


